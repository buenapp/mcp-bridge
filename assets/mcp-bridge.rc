#include <winresrc.h>

#define VER_FILEVERSION 0,1,1,0
#define VER_FILEVERSION_STR "0.1.1\0"
#define VER_PRODUCTVERSION_STR "0.1.1\0"

1 ICON "mcp-bridge.ico"

1 VERSIONINFO
FILEVERSION VER_FILEVERSION
PRODUCTVERSION VER_FILEVERSION
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "The Daniel Morante Company, Inc.\0"
            VALUE "FileDescription", "MCP stdio bridge (Windows) with DANE TLSA\0"
            VALUE "FileVersion", VER_FILEVERSION_STR
            VALUE "InternalName", "mcp-bridge\0"
            VALUE "LegalCopyright", "BSD-2-Clause\0"
            VALUE "OriginalFilename", "mcp-bridge.exe\0"
            VALUE "ProductName", "MCP Bridge\0"
            VALUE "ProductVersion", VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
